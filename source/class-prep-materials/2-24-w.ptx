<?xml version="1.0" encoding="UTF-8"?>

<section xml:id="prep-2-24">
  <title>Resources for 2/24</title>

  <objectives>
    <introduction>
      <p>For the content of this class, you will be expected to be able to do the following:</p>
    </introduction>
    <ul>
      <li>
        <p>
          Implement <em>Warshall's algorithm</em> to find the transitive closure of a relation.
        </p>
      </li>
    </ul>
  </objectives>

  <subsection xml:id="video-activity-warshall">
    <title>Video &amp; Activities for Warshall Algorithm</title>
    <p>
      Below is a YouTube video on the <em>Warshall Algorithm</em>, which is an efficient way of finding the transitive closure of a relation. It is followed by a link to a set of activities that we will be working on in class. Please watch the video and do as many of the activities as you can before class.
    </p>

    <video youtube="IZzOgiYB4o4" />

    <problem>
      <title>Warshall's Algorithm</title>
      <p>
      Use Warshall's Algorithm to find the transitive closure of the following relations.  Make sure you show what arrows are added at each step.
      </p>
      <sidebyside widths="45% 45%">
        <image>
          <prefigure xmlns="https://prefigure.org" label="image-prep-warshall-1">
            <diagram dimensions="(300,300)" margins="5">
              <definition>warsh1={1:[3],2:[4],3:[4],5:[1,2]}</definition>
              <coordinates bbox="(-1,-1,1,1)">
                <network directed="yes" graph="warsh1" node-fill="white" labels="yes" 
                scale="0.8" seed="16" node-stroke="no">
                  <node at="1" p="(-0.9,0.5)" />
                  <node at="2" p="(0,0.5)" />
                  <node at="3" p="(0.9,0.5)" />
                  <node at="4" p="(-0.5,-0.5)" />
                  <node at="5" p="(0.5,-0.5)" />
                </network>
              </coordinates>
            </diagram>
          </prefigure>
        </image>
        <image>
          <prefigure xmlns="https://prefigure.org" label="image-prep-warshall-2">
            <diagram dimensions="(300,300)" margins="5">
              <definition>warsh2={1:[2],2:[6],3:[2], 4:[2],5:[4]}</definition>
              <coordinates bbox="(-1,-1,1,1)">
                <network directed="yes" graph="warsh2" node-fill="white" labels="yes" 
                scale="0.8" seed="16" node-stroke="no">
                  <node at="1" p="(-0.9,0.5)" />
                  <node at="2" p="(0,0.5)" />
                  <node at="3" p="(0.9,0.5)" />
                  <node at="4" p="(-0.9,-0.5)" />
                  <node at="5" p="(0,-0.5)" />
                  <node at="6" p="(0.9,-0.5)" />
                </network>
              </coordinates>
            </diagram>
          </prefigure>
        </image>
      </sidebyside>
    </problem>
  </subsection>

  <subsection>
    <title>Optional Reading</title>
    <p>
      <url href="">Transitive Closure and Warshall's Algorithm</url>
    </p>
  </subsection>
</section>