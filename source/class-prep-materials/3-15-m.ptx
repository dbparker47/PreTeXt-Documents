              <image>
                <prefigure xmlns="https://prefigure.org" label="image-prep-coloring-5">
                  <diagram dimensions="(300,300)" margins="5">
                    <definition>undirected1={1:[2,3,5],2:[3],3:[4],4:[5]}</definition>
                    <definition>labels={1:'v_1',2:'v_2',3:'v_3',4:'v_4',5:'v_5',6:'w_1',7:'w_2',8:'w_3'}</definition>
                    <definition>N=5</definition>
                    <definition>f(t)=(cos(2*pi*t/N), sin(2*pi*t/N))</definition>
                    <coordinates bbox="(-1.02,-1.02,1.02,1.02)">
                      <network directed="no" graph="undirected1" labels="no" 
                      label-dictionary="labels" scale="0.8" node-stroke="black" node-fill="black" node-size="7" >
                        <node at="1" p="f(1)" />
                        <node at="2" p="f(2)" />
                        <node at="3" p="f(3)" />
                        <node at="4" p="f(4)" />
