              </image>
            </sidebyside>
            <sidebyside widths="30% 30% 30%">
              <image>
                <prefigure xmlns="https://prefigure.org" label="image-prep-coloring-7">
                  <diagram dimensions="(300,300)" margins="5">
                    <definition>undirected1={1:[4,5],2:[4,5],3:[4,5]}</definition>
                    <definition>labels={1:'v_1',2:'v_2',3:'v_3',4:'v_4',5:'v_5',6:'w_1',7:'w_2',8:'w_3'}</definition>
                    <coordinates bbox="(0,0,1,1)">
                      <network directed="no" graph="undirected1" node-fill="black" labels="no" 
                      label-dictionary="labels" scale="0.8" node-stroke="black" node-size="7" >
                        <node at="1" p="(0.2,0.9)" />
                        <node at="2" p="(0.2,0.5)" />
                        <node at="3" p="(0.2,0.1)" />
                        <node at="4" p="(0.8,0.7)" />
                        <node at="5" p="(0.8,0.3)" />
                      </network>
                    </coordinates>
                  </diagram>
                </prefigure>
              </image>
              <image>
                <prefigure xmlns="https://prefigure.org" label="image-prep-coloring-8">
                  <diagram dimensions="(300,300)" margins="5">
                    <definition>undirected1={1:[2,4,5],2:[3,5,4,7],3:[6],4:[5],5:[6,7],6:[7]}</definition>
                    <definition>labels={1:'v_1',2:'v_2',3:'v_3',4:'v_4',5:'v_5',6:'w_1',7:'w_2',8:'w_3'}</definition>
                    <coordinates bbox="(0,0,1,1)">
                      <network directed="no" graph="undirected1" node-fill="black" labels="no" 
                      label-dictionary="labels" scale="0.8" node-stroke="black" node-size="7" >
                        <node at="1" p="(0.1,0.7)" />
                        <node at="2" p="(0.5,0.7)" />
                        <node at="3" p="(0.9,0.7)" />
                        <node at="4" p="(0.1,0.3)" />
                        <node at="5" p="(0.5,0.3)" />
                        <node at="6" p="(0.9,0.3)" />
                        <node at="7" p="(0.7,0.5)" />
                      </network>
                    </coordinates>
                  </diagram>
                </prefigure>
              </image>
              <image>
                <prefigure xmlns="https://prefigure.org" label="image-prep-coloring-9">
                  <diagram dimensions="(300,300)" margins="5">
                    <definition>undirected1={1:[2,5],2:[3,5,6,7],3:[4,5,6,7],4:[7],5:[6],6:[7]}</definition>
                    <definition>labels={1:'v_1',2:'v_2',3:'v_3',4:'v_4',5:'v_5',6:'w_1',7:'w_2',8:'w_3'}</definition>
                    <coordinates bbox="(0,0,1,1)">
                      <network directed="no" graph="undirected1" node-fill="black" labels="no" 
                      label-dictionary="labels" scale="0.8" node-stroke="black" node-size="7" >
                        <node at="1" p="(0.05,0.7)" />
                        <node at="2" p="(0.35,0.7)" />
                        <node at="3" p="(0.65,0.7)" />
                        <node at="4" p="(0.95,0.7)" />
                        <node at="5" p="(0.2,0.3)" />
                        <node at="6" p="(0.5,0.3)" />
                        <node at="7" p="(0.8,0.3)" />
                      </network>
