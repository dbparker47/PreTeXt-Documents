<?xml version="1.0" encoding="UTF-8"?>

<worksheet xml:id="act-digraph">
  <title>Digraphs &amp; Shortest Path Algorithms (No Quiz)</title>

  <image>
    <prefigure xmlns="https://prefigure.org" label="image-act-short-path-digraph">
        <diagram dimensions="(300,300)" margins="5">
            <definition>graph={1:[2,5],2:[3],3:[4],4:[5]}</definition>
            <definition>labels={1:'a',2:'b',3:'c',4:'d',5:'e',6:'f',7:'g'}</definition>
            <coordinates bbox="(0,0,1,1)">
                <network directed="yes" labels="yes" label-dictionary="labels"
                scale="0.8" node-stroke="black" node-fill="white" >
                  <node at="1" p="(0.1,0.5)" />
                  <node at="2" p="(0.3,0.8)" />
                  <node at="3" p="(0.7,0.8)" />
                  <node at="4" p="(0.9,0.5)" />
                  <node at="5" p="(0.7,0.2)" />
                  <node at="6" p="(0.3,0.2)" />
                  <node at="7" p="(0.5,0.5)" />
                  <edge vertices="(1,2)"><m>4</m></edge>
                  <edge vertices="(1,6)"><m>5</m></edge>
                  <edge vertices="(2,3)"><m>2</m></edge>
                  <edge vertices="(2,7)"><m>1</m></edge>
                  <edge vertices="(3,4)"><m>10</m></edge>
                  <edge vertices="(3,7)"><m>3</m></edge>
                  <edge vertices="(4,5)"><m>6</m></edge>
                  <edge vertices="(5,6)"><m>4</m></edge>
                  <edge vertices="(7,1)"><m>2</m></edge>
                  <edge vertices="(7,4)"><m>2</m></edge>
                  <edge vertices="(7,5)"><m>4</m></edge>
                  <edge vertices="(7,6)"><m>8</m></edge>
                </network>
            </coordinates>
        </diagram>
    </prefigure>
  </image>

  <p>
    Use either Dijkstra's or Improved Dijkstra's Algorithm on the weighted digraph above to determine the distance between <m>a</m> and the other vertices.
  </p>
</worksheet>