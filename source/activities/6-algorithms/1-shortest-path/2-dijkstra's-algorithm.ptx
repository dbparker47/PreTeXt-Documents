<?xml version="1.0" encoding="UTF-8"?>

<worksheet xml:id="act-dijkstra">
  <title>Dijkstra's Algorithm</title>

  <image>
    <prefigure xmlns="https://prefigure.org" label="image-act-dijkstra">
        <diagram dimensions="(300,300)" margins="5">
            <definition>labels={1:'A',2:'B',3:'C',4:'D',5:'E',6:'F',7:'G',8:'H',9:'I',10:'J',11:'K',12:'L',13:'M'}</definition>
            <coordinates bbox="(0,0,1,1)">
                <network directed="no" labels="yes" label-dictionary="labels"
                scale="0.8" node-stroke="black" node-fill="white" >
                  <node at="1" p="(0.05,0.5)" />
                  <node at="2" p="(0.18,0.8)" />
                  <node at="3" p="(0.31,0.5)" />
                  <node at="4" p="(0.18,0.2)" />
                  <node at="5" p="(0.44,0.8)" />
                  <node at="6" p="(0.57,0.5)" />
                  <node at="7" p="(0.44,0.2)" />
                  <node at="8" p="(0.7,0.8)" />
                  <node at="9" p="(0.765,0.5)" />
                  <node at="10" p="(0.7,0.2)" />
                  <node at="11" p="(0.96,0.8)" />
                  <node at="12" p="(0.96,0.5)" />
                  <node at="13" p="(0.96,0.2)" />
                  <edge vertices="(1,2)"><m>2</m></edge>
                  <edge vertices="(1,3)"><m>7</m></edge>
                  <edge vertices="(1,4)"><m>3</m></edge>
                  <edge vertices="(2,3)"><m>4</m></edge>
                  <edge vertices="(2,5)"><m>2</m></edge>
                  <edge vertices="(3,4)"><m>4</m></edge>
                  <edge vertices="(3,5)"><m>1</m></edge>
                  <edge vertices="(3,6)"><m>2</m></edge>
                  <edge vertices="(3,7)"><m>3</m></edge>
                  <edge vertices="(4,7)"><m>4</m></edge>
                  <edge vertices="(5,6)"><m>5</m></edge>
                  <edge vertices="(5,8)"><m>6</m></edge>
                  <edge vertices="(5,9)"><m>8</m></edge>
                  <edge vertices="(6,7)"><m>3</m></edge>
                  <edge vertices="(6,9)"><m>2</m></edge>
                  <edge vertices="(7,9)"><m>3</m></edge>
                  <edge vertices="(7,10)"><m>4</m></edge>
                  <edge vertices="(8,11)"><m>4</m></edge>
                  <edge vertices="(9,11)"><m>2</m></edge>
                  <edge vertices="(9,12)"><m>6</m></edge>
                  <edge vertices="(10,13)"><m>7</m></edge>
                  <edge vertices="(11,12)"><m>3</m></edge>
                  <edge vertices="(12,13)"><m>2</m></edge>
                </network>
            </coordinates>
        </diagram>
    </prefigure>
  </image>

  <exercise workspace="2in">
    <statement>
      <p>
        Use Dijkstra's algorithm to find distances between vertices of the graph above.  In particular, find the distances between <m>A</m> and all other vertices, and find the distances between <m>K</m> and all other vertices.
      </p>
    </statement>
  </exercise>

  <exercise workspace="2in">
    <statement>
      <p>
        Use Improved Dijkstra's algorithm to find distances between vertices of the graph above. Try different vertices as starting points. In particular, find the distances between <m>A</m> and all other vertices, and find the distances between <m>K</m> and all other vertices.
      </p>
    </statement>
  </exercise>

</worksheet>