<?xml version="1.0" encoding="UTF-8"?>

<!-- When creating a new activity, make a copy of this file with appropriate name -->
<worksheet xml:id="act-contrapositive">
  <title>Proof by Contrapositive</title>

  <!-- Optional introduction -->
  <introduction>
    <p>
      Use a logically equivalent form of the statement to prove the following theorems.
    </p>
  </introduction>

  <exercise>
    <statement>
      <p>
        If the sum of two real numbers is less than 50, then at least one of the numbers is less than 25.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        If <m>a</m>, <m>b</m>, and <m>c</m> are integers and <m>a</m> does not divide <m>bc</m>, then <m>a</m> does not divide <m>b</m>.  Hint:  Separate out one of the assumptions to make the contrapositive easier to prove.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        For all integers <m>m</m> and <m>n</m>, if <m>m+n</m> is even, then <m>m</m> and <m>n</m> are both even or <m>m</m> and <m>n</m> are both odd.
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Let <m>a</m>, <m>b</m>, and <m>c</m> be integers.  If <m>a|b</m> and <m>a</m> does not divide <m>c</m>, then <m>a</m> does not divide <m>b+c</m>.
      </p>
    </statement>
  </exercise>

</worksheet>