<?xml version="1.0" encoding="UTF-8"?>

<!-- When creating a new activity, make a copy of this file with appropriate name -->
<worksheet xml:id="act-induction">
  <title>Proof by Induction</title>

  <!-- Optional introduction -->
  <introduction>
    <p>
      Use induction to prove the following.
    </p>
  </introduction>

  <exercise>
    <statement>
      <p>
        <m>1+r+r^2+r^3+ \ldots + r^n = \frac{r^{n+1}-1}{r-1}</m>
      </p>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        <m>\frac{1}{1 \cdot 2}+ \frac{1}{2 \cdot 3}+\frac{1}{3 \cdot 4}+\ldots + \frac{1}{n(n+1)}=\frac{n}{n+1}</m>
      </p>
    </statement>
  </exercise>

</worksheet>