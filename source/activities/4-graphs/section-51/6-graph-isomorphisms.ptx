<?xml version="1.0" encoding="UTF-8"?>

<!-- When creating a new activity, make a copy of this file with appropriate name -->
<worksheet xml:id="act-graph-isomorphism">
  <title>Graph Isomorphisms</title>

  <!-- Optional introduction -->
  <introduction>
    <p>
      Work the following problems related to isomorphic graphs.
    </p>
  </introduction>

  <exercise>
    <statement>
      <p>
        Find all pairs of graphs that are isomorphic.  Define the isomorphism, and show that it is an isomorphism.  Find the pairs that are not isomorphic, and show no isomorphism exists in those cases.
      </p>
      <sidebyside widths="30% 30% 30%">
        <image>
          <prefigure xmlns="https://prefigure.org" label="isomorphism-1">
            <diagram dimensions="(300,300)" margins="5">
            <definition>undirected1={1:[2,4],2:[3,4]}</definition>
            <definition>labels={1:'a',2:'b',3:'c',4:'d',5:'e',6:'f'}</definition>
            <coordinates bbox="(0,0,1,1)">
              <network directed="no" graph="undirected1" node-fill="black" labels="no" 
              label-dictionary="labels" scale="0.8" seed="16" node-stroke="black" node-size="5">
                <node at="1" p="(0.2,0.5)" />
                <node at="2" p="(0.5,0.5)" />
                <node at="3" p="(0.8,0.8)" />
                <node at="4" p="(0.8,0.2)" />
              </network>
            </coordinates>
          </diagram>
        </prefigure>
      </image>
      <image>
        <prefigure xmlns="https://prefigure.org" label="isomorphism-2">
          <diagram dimensions="(300,300)" margins="5">
            <definition>undirected1={1:[3],2:[4],3:[4,5],4:[5]}</definition>
            <definition>labels={1:'a',2:'b',3:'c',4:'d',5:'e',6:'f'}</definition>
            <coordinates bbox="(0,0,1,1)">
              <network directed="no" graph="undirected1" node-fill="black" labels="no" 
              label-dictionary="labels" scale="0.8" seed="16" node-stroke="black" node-size="5">
                <node at="1" p="(0.2,0.8)" />
                <node at="2" p="(0.8,0.8)" />
                <node at="3" p="(0.2,0.4)" />
                <node at="4" p="(0.8,0.4)" />
                <node at="5" p="(0.5,0.1)" />
              </network>
            </coordinates>
          </diagram>
        </prefigure>
      </image>
      <image>
        <prefigure xmlns="https://prefigure.org" label="isomorphism-3">
          <diagram dimensions="(300,300)" margins="5">
            <definition>undirected1={1:[2],2:[4,5],3:[5],4:[5]}</definition>
            <definition>labels={1:'a',2:'b',3:'c',4:'d',5:'e',6:'f'}</definition>
            <coordinates bbox="(0,0,1,1)">
              <network directed="no" graph="undirected1" node-fill="black" labels="no" 
              label-dictionary="labels" scale="0.8" seed="16" node-stroke="black" node-size="5">
                <node at="1" p="(0.2,0.8)" />
                <node at="2" p="(0.8,0.8)" />
                <node at="3" p="(0.6,0.4)" />
                <node at="4" p="(0.2,0.2)" />
                <node at="5" p="(0.8,0.2)" />
              </network>
            </coordinates>
          </diagram>
        </prefigure>
      </image>
    </sidebyside>
    <sidebyside widths="30% 30% 30%">
      <image>
        <prefigure xmlns="https://prefigure.org" label="isomorphism-4">
          <diagram dimensions="(300,300)" margins="5">
            <definition>undirected1={1:[2,3,4],2:[4]}</definition>
            <definition>labels={1:'a',2:'b',3:'c',4:'d',5:'e',6:'f'}</definition>
            <coordinates bbox="(0,0,1,1)">
              <network directed="no" graph="undirected1" node-fill="black" labels="no" 
              label-dictionary="labels" scale="0.8" seed="16" node-stroke="black" node-size="5">
                <node at="1" p="(0.2,0.8)" />
                <node at="2" p="(0.8,0.8)" />
                <node at="3" p="(0.2,0.2)" />
                <node at="4" p="(0.8,0.2)" />
              </network>
            </coordinates>
          </diagram>
        </prefigure>
      </image>
      <image>
        <prefigure xmlns="https://prefigure.org" label="isomorphism-5">
          <diagram dimensions="(300,300)" margins="5">
            <definition>undirected1={1:[2,3,4]}</definition>
            <definition>labels={1:'a',2:'b',3:'c',4:'d',5:'e',6:'f'}</definition>
            <coordinates bbox="(0,0,1,1)">
              <network directed="no" graph="undirected1" node-fill="black" labels="no" 
              label-dictionary="labels" scale="0.8" seed="16" node-stroke="black" node-size="5">
                <node at="1" p="(0.2,0.8)" />
                <node at="2" p="(0.8,0.8)" />
                <node at="3" p="(0.2,0.2)" />
                <node at="4" p="(0.8,0.2)" />
              </network>
            </coordinates>
          </diagram>
        </prefigure>
      </image>
      <image>
        <prefigure xmlns="https://prefigure.org" label="isomorphism-6">
          <diagram dimensions="(300,300)" margins="5">
            <definition>undirected1={1:[2,3,4],2:[5],3:[4]}</definition>
            <definition>labels={1:'a',2:'b',3:'c',4:'d',5:'e',6:'f'}</definition>
            <coordinates bbox="(0,0,1,1)">
              <network directed="no" graph="undirected1" node-fill="black" labels="no" 
              label-dictionary="labels" scale="0.8" seed="16" node-stroke="black" node-size="5">
                <node at="1" p="(0.2,0.8)" />
                <node at="2" p="(0.6,0.8)" />
                <node at="3" p="(0.2,0.2)" />
                <node at="4" p="(0.6,0.2)" />
                <node at="5" p="(0.9,0.5)" />
              </network>
            </coordinates>
          </diagram>
        </prefigure>
      </image>
    </sidebyside>

    <image>
      <prefigure xmlns="https://prefigure.org" label="isomorphism-7">
        <diagram dimensions="(300,300)" margins="5">
          <definition>undirected1={1:[3,4],2:[3,5],3:[5]}</definition>
          <definition>labels={1:'a',2:'b',3:'c',4:'d',5:'e',6:'f'}</definition>
          <coordinates bbox="(0,0,1,1)">
            <network directed="no" graph="undirected1" node-fill="black" labels="no" 
            label-dictionary="labels" scale="0.8" seed="16" node-stroke="black" node-size="5">
              <node at="1" p="(0.2,0.8)" />
              <node at="2" p="(0.8,0.8)" />
              <node at="3" p="(0.2,0.4)" />
              <node at="4" p="(0.8,0.4)" />
              <node at="5" p="(0.5,0.1)" />
            </network>
          </coordinates>
        </diagram>
      </prefigure>
    </image>
    </statement>
  </exercise>

  <exercise>
    <statement>
      <p>
        Find all nonisomorphic graphs with seven vertices that all have degree 2.  Prove your result.
      </p>
    </statement>
  </exercise>

</worksheet>