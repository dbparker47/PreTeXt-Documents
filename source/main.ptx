<?xml version="1.0" encoding="UTF-8"?>

<!-- This is the main course file for ... . It is used to generate all the public facing course materials so those can be hosted online.  -->
<pretext xmlns:xi="http://www.w3.org/2001/XInclude">
  <!-- Include common macros etc: -->
  <xi:include href="./docinfo.ptx" />
  <!-- By creating a PreTeXt "book" for the course, we can split components into "chapters" -->
  <book>
    <title>Math 325</title>

    <subtitle>Winter 2027
      
    </subtitle>

    <!-- Optional: include frontmatter with author info and date -->
    <xi:include href="./frontmatter.ptx" />

    <chapter xml:id="course-documents">
      <title>Course Documents</title>
      <xi:include href="./documents/syllabus.ptx" />
      <xi:include href="./documents/objectives.ptx" />
      <!-- Other documents could go here, like a schedule, project description, etc. -->
    </chapter>

    <chapter xml:id="exam">
      <title>Exams</title>
        <xi:include href="./exams/exam-1.ptx"/>
        <xi:include href="./exams/exam-2.ptx"/>
        <xi:include href="./exams/exam-3.ptx"/>
        <xi:include href="./exams/final-exam.ptx"/>
        <!-- etc. -->
    </chapter>

    <chapter xml:id="homework">
      <title>Homework Assignments</title>
      <xi:include href="./homework-coding/homework-1.ptx"/>
    </chapter>

    <chapter xml:id="coding">
      <title>Coding Assignments</title>
      <xi:include href="./homework-coding/coding-1.ptx"/>
    </chapter>

    <chapter xml:id="in-class-12-31">
      <title>In-Class Activities: Sections 1.2 &amp; 3.1</title>
      <xi:include href="./activities/section-12-31/1-introduction-to-proofs.ptx"/>
      <xi:include href="./activities/section-12-31/2-divisibility-and-congruence.ptx"/>
    </chapter>

    <chapter xml:id="in-class-32">
      <title>In-Class Activities: Section 3.2</title>
      <xi:include href="./activities/section-32/1-proof-by-contrapositive.ptx"/>
    </chapter>

    <chapter xml:id="screencasts">
      <title>Screencast Slides</title>
      <xi:include href="./slides/slides.ptx"/>
    </chapter>    
  </book>
</pretext>
